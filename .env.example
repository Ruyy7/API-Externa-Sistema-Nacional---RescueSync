# Copiar a .env. Nunca commitear .env.
POSTGRES_DB=sistema_nacional
POSTGRES_USER=sistema_nacional
POSTGRES_PASSWORD=cambiar-esto

JWT_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria

# Tope de espera (ms) por una fila bloqueada antes de responder 409 RECURSO_OCUPADO (I-3.4)
LOCK_TIMEOUT_MS=5000

LOG_LEVEL=INFO

# Contraseñas de las cuentas de servicio que crea `flask cuentas-servicio` (I-3.1).
# Inician sesión en POST /api/v1/login con usuario webapp, bonita o auditor.
CUENTA_WEBAPP_PASSWORD=cambiar-esto
CUENTA_BONITA_PASSWORD=cambiar-esto
CUENTA_AUDITOR_PASSWORD=cambiar-esto

# Puertos del host; se usan distintos a RescueSync para poder levantar ambos a la vez.
# para derivar DATABASE_URL contra localhost. Docker Compose inyecta su propia URL con host `db`.
DB_PORT=5433
API_PORT=5001
